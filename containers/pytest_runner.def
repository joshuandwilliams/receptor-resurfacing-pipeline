# =============================================================================
# pytest_runner.def — build the Apptainer image from the test Docker image.
#
# There is nothing to install here. containers/Dockerfile.test decides the
# contents and verifies them at build time. This file converts that image and
# sets the runtime environment. %post is deliberately almost empty, because
# anything added here would be a second place the image contents are decided.
#
# -----------------------------------------------------------------------------
# WHICH SOURCE TO USE
#
# From a machine with Docker, build the image and convert it locally, with no
# registry involved:
#
#   docker build -t rrp-test:dev -f containers/Dockerfile.test .
#   apptainer build pytest_runner.img docker-daemon://rrp-test:dev
#
# From the cluster's software node, where there is no Docker daemon, swap the
# Bootstrap block below for a `docker` bootstrap against a registry you can
# reach, then:
#
#   apptainer build pytest_runner.img containers/pytest_runner.def
#
# -----------------------------------------------------------------------------
# WHAT CHANGED FROM THE PREVIOUS VERSION OF THIS FILE
#
# It used to build the image itself: an AlmaLinux 9 bootstrap from
# http://yum-repos.hpccluster/, a from-source build of Python 3.11.9 with
# --enable-optimizations, and nine pip packages listed with version floors.
#
# Three problems went with that. The mirror URL resolves only inside the JIC
# network, so the file could not be built anywhere else. The Python compile
# took most of the build for a feature, sqlite support, that the distro
# package already has. And the nine-package list was a second copy of
# pyproject.toml's `test` extra that had to be kept in step by hand; it had
# already drifted, which is how gemmi came to be absent from the extra while
# present here, making seven tests skip silently rather than run.
#
# Dockerfile.test installs `.[test]`, so pyproject is now the only declaration.
# =============================================================================
Bootstrap: docker-daemon
From: rrp-test:dev

%environment
    # matplotlib and any transitive numba importer need a writable config
    # directory, because the image is read-only at run time.
    export MPLCONFIGDIR=/tmp
    export NUMBA_CACHE_DIR=/tmp
    export MPLBACKEND=Agg
    export PATH=/usr/local/bin:$PATH

%runscript
    exec pytest "$@"

%test
    # Fail the build rather than a later test run if the conversion dropped a
    # compiled extension. gemmi and Pillow are the two that would.
    python -c "import pytest, pandas, numpy, scipy, gemmi, PIL, skimage, Bio, matplotlib; \
               matplotlib.use('Agg'); print('pytest_runner: imports OK')"

%labels
    Description Logic-tier test suite for receptor-resurfacing-pipeline
    Source      containers/Dockerfile.test

%help
    Run the logic tier against a bind-mounted checkout:

      apptainer exec -B "$PWD:$PWD" --pwd "$PWD" pytest_runner.img \
          pytest -m logic

    The repository is bind-mounted rather than baked in, so the image does
    not go stale when a test changes.

    The check_test_run tier is not runnable here. It needs
    RECEPTOR_OUTPUT_ROOT pointing at a finished pipeline run.
