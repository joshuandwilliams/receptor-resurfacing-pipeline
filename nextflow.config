/*
 * =============================================================================
 * Nextflow Configuration — Receptor Resurfacing Pipeline v0.2.0
 * =============================================================================
 */

params {
    project_name       = "receptor_resurfacing"
    outdir             = "${projectDir}/${params.project_name}_results"
    max_af3_parallel    = 30      // AF3 runs natively via `source package`,
                                  // not via a container — fan wide.
                                  // Boltz2 GPU concurrency is bounded by
                                  // executor.queueSize and SLURM's jic-gpu
                                  // partition — no maxForks needed.

    // ── HADDOCK clustering ─────────────────────────────────────────────
    haddock_min_cluster_size = 4

    // ── Orthogonal cascade scope ───────────────────────────────────────
    // Which sequences receive AF3 + biophysical + Rosetta metrics.
    //   'all' (default): every steered design, including tier-none failed
    //                    designs.  Useful diagnostic — orthogonal metrics
    //                    can explain WHY a design failed even when its
    //                    negsteer tier is none.
    //   'abc':           restrict to cross_tier in (A, B, C).  Lower
    //                    GPU/CPU cost when only survivors are of interest.
    orthogonal_tier_filter = 'all'
    // ── Singularity images ─────────────────────────────────────────────
    rfdiff_container    = "/hpc-home/jowillia/singularity/HADDOCK_RFDiffusion_ProteinMPNN_MMseqs2/HADDOCK_RFDiffusion_ProteinMPNN_MMseqs2.img"
    rosetta_container   = "/hpc-home/jowillia/singularity/Rosetta/Rosetta.img"
    boltz2_container    = "/hpc-home/jowillia/singularity/Boltz1_Boltz2_Chai1_ColabFold/boltz2_negsteer.img"
    colabfold_container = "/hpc-home/jowillia/singularity/ColabFold/colabfold.img"

    // ── AlphaFold 3 (P0-31 orthogonal validation) ─────────────────────
    // AF3 on NBI is not containerised — it's loaded via `source package`.
    // The three paths below must exist on the build host.
    af3_package_id = "e8edb411-7374-4342-b9f1-408da41fc197"
    af3_model_dir  = "${System.getenv('HOME')}/singularity/AlphaFold3"   // contains af3.bin
    af3_db_v3      = "/nbi/Reference-Data/AlphaFold/db-v3.0.0"
    af2_data_dir   = "/nbi/Reference-Data/AlphaFold/db-v2.3.2"  // BFD + MGnify
}

process {
    executor       = 'slurm'
    queue          = 'jic-medium'
    memory         = '8 GB'
    cpus           = 4
    time           = '4h'
    errorStrategy  = 'retry'
    maxRetries     = 1
}

profiles {
    standard { process.executor = 'slurm' }
    local    { process.executor = 'local' }
}

singularity {
    enabled = false
}

executor {
    name            = 'slurm'
    queueSize       = 20
    submitRateLimit = '10 sec'
    jobName         = { "rr_${task.process.tokenize(':')[-1]}_${task.index}" }
    exitReadTimeout = '25h'
}

process {

    // ── Preprocessing ────────────────────────────────────────────────
    withName: 'EXTRACT_SEQUENCES' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    // ── HADDOCK3 ─────────────────────────────────────────────────────
    withName: 'HADDOCK3_PREPARE' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'HADDOCK3_DOCK' {
        queue  = 'jic-medium'
        cpus   = 64
        memory = '128 GB'
        time   = '48h'
        clusterOptions = '--exclusive'
    }

    withName: 'HADDOCK3_PLOTS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'HADDOCK_CLUSTER_METRICS' {
        queue  = 'jic-medium'
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
    }

    withName: 'HADDOCK_CLUSTER_SC' {
        queue  = 'jic-medium'
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
    }

    withName: 'SELECT_HADDOCK_CLUSTER' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '15m'
    }

    withName: 'BUILD_CONTIGS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    // ── RFDiffusion ──────────────────────────────────────────────────
    withName: 'RFDIFFUSION' {
        queue          = 'jic-gpu'
        cpus           = 20
        memory         = '64 GB'
        time           = '12h'
        clusterOptions = '--gres=gpu:1'
    }

    withName: 'RFDIFFUSION_FILTER' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'RFDIFFUSION_PLOTS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    // ── ProteinMPNN ──────────────────────────────────────────────────
    withName: 'MPNN_FIXED_POSITIONS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'PROTEINMPNN' {
        queue  = 'jic-medium'
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }

    withName: 'SEQUENCE_CORRECTION' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'SEQUENCE_QC' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'MPNN_DESIGN_REGION_SCORE' {
        queue  = 'jic-medium'
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }

    withName: 'MPNN_CLUSTER' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'MPNN_PLOTS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'MPNN_SELECT_TOP' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    // ── Negative steering ─────────────────────────────────────────────
    // Resource sizing based on trace.txt from the 16-sequence overnight
    // run (notes13).  Observed peaks across all NEGSTEER_RUN_ONE tasks:
    //   %cpu        peak 144% (~1.4 cores)
    //   peak_rss    ceiling 5.1 GB
    //   peak_vmem   ceiling 19.3 GB (mmap'd Boltz weights, not RSS)
    //   realtime    median 105 min, max 247 min (single outlier)
    // Memory sizing is on peak_rss (what SLURM enforces), not vmem.
    // Time gives >45% headroom above observed worst case to cover the
    // odd design that spends extra time in reversion.  CPU rounded up
    // to 4 for I/O bursts in the reversion predict stage.

    withName: 'NEGSTEER_DERIVE_INDICES' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '1 GB'
        time   = '5m'
    }

    // DERIVE_INPUT_INDICES (negsteer_controls.nf) — CPU-only sister
    // process to NEGSTEER_DERIVE_INDICES.  Reads the input PDB +
    // contigs, computes the design region and true interface for
    // the controls.  Comparable resource profile.
    withName: 'DERIVE_INPUT_INDICES' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '1 GB'
        time   = '5m'
    }

    withName: 'NEGSTEER_RUN_ONE' {
        queue          = 'jic-gpu'
        cpus           = 4
        memory         = '12 GB'
        time           = '6h'
        clusterOptions = '--gres=gpu:1'
    }

    // NEGSTEER_CONTROLS (negsteer_controls.nf) — GPU sister to
    // NEGSTEER_RUN_ONE.  Calls the same negative_steering_run_one.sh
    // orchestrator so its resource needs are the same.  WITHOUT this
    // explicit block the process inherits the global defaults
    // (jic-medium, no --gres) and lands on a CPU node where
    // singularity --nv can't find host driver libraries — the
    // orchestrator's first stage (`plan`) then fails inside Boltz
    // with "No supported gpu backend found!".  The `label 'gpu'`
    // decorator on the process IS NOT enough on its own — Nextflow
    // does not route based on labels unless there is a withLabel:
    // directive, which this config does not currently use.
    //
    // Sized 1 design × 3 seeds (n_designs=1 in the controls
    // configuration) so wall-clock is much smaller than RUN_ONE,
    // but resource SHAPE is identical (same orchestrator, same
    // container, same plan/predict/reversion stages).
    withName: 'NEGSTEER_CONTROLS' {
        queue          = 'jic-gpu'
        cpus           = 4
        memory         = '12 GB'
        time           = '2h'
        clusterOptions = '--gres=gpu:1'
    }

    withName: 'NEGSTEER_CROSS_SEQUENCE' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '1 GB'
        time   = '5m'
    }

    // ── Interface-restricted metrics (P0-29) ─────────────────────────
    // Single CPU job over the cross-sequence CSV.  DockQ + iPSAE + core
    // RMSD per row; ~1-3 s per row.  Sized for cohorts up to ~200 rows.
    withName: 'NEGSTEER_INTERFACE_METRICS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    // ── Orthogonal validation metrics (P0-31) ────────────────────────
    // Five processes spanning three parallel streams:
    //   AF3_SETUP_DB              → once, builds $HOME/af3_db symlink farm
    //   AF3_NOMSA_ON_SURVIVORS    → fan-out, one GPU job per survivor
    //   NEGSTEER_BIOPHYSICAL_METRICS → fan-out, one CPU job per survivor
    //   NEGSTEER_ROSETTA_METRICS  → fan-out, one CPU job per survivor
    //   NEGSTEER_ORTHOGONAL_METRICS → once, joins streams into final CSV

    withName: 'AF3_SETUP_DB' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '2 GB'
        time   = '15m'
    }

    withName: 'AF3_NOMSA_ON_SURVIVORS' {
        queue          = 'jic-gpu'
        cpus           = 20
        memory         = '64 GB'
        time           = '2h'
        clusterOptions = '--gres=gpu:1'
        maxForks       = params.max_af3_parallel
    }

    withName: 'NEGSTEER_BIOPHYSICAL_METRICS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'NEGSTEER_ROSETTA_METRICS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'NEGSTEER_ORTHOGONAL_METRICS' {
        queue  = 'jic-medium'
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

}

report   { enabled = true; file = "${params.outdir}/pipeline_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/timeline.html";        overwrite = true }
trace    {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
    // Explicit field list so the resource-usage columns are always
    // present — without this override Nextflow omits %cpu / peak_rss /
    // peak_vmem on some cluster configurations.
    fields    = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,time'
}
dag      { enabled = true; file = "${params.outdir}/dag.html";            overwrite = true }

notification { enabled = false }

manifest {
    name            = 'receptor-resurfacing-pipeline'
    author          = 'Josh Williams'
    description     = 'HADDOCK3 → RFDiffusion → ProteinMPNN → Boltz2 (+ negative steering) pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.2.0'
}