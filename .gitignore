# ============================================================
# .gitignore for receptor-resurfacing-pipeline
# ============================================================

# ----- Nextflow -----
.nextflow/
.nextflow.log*
.nextflow.history*
work/
tests/*/work/
tests/*/tmp/

# ----- Pipeline outputs -----
# Adjust these if your output directory naming changes
results/
tests/*/results/
tests/*/receptor_resurfacing_results/

# ----- SLURM logs -----
*.out
*.err
slurm-*.out
slurm-*.err

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# ----- Jupyter -----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Microsoft Office lock files -----
~$*

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ----- Environment / secrets -----
.env
.env.local
*.local

# ----- Build / packaging artifacts -----
build/
dist/
*.egg
.eggs/

# ----- Java / JDK (if anything bundled) -----
jdk-*/
*.class
*.jar

# ----- Singularity containers (containers/) -----
# The .def build recipes and README.md ARE tracked.  The built images —
# and the machine-local symlinks that point at them on the HPC software
# node — are NOT: they are large binaries / per-install paths.  To install
# the pipeline, drop your own .img/.sif (or symlinks to them) into
# containers/ using the filenames wired up in nextflow.config.
containers/*.img
containers/*.sif
containers/jdk-17.0.2

# ----- Nextflow home (in case it gets recreated locally) -----
nxf_home/

# ----- Archive / scratch directories -----
archive/
scratch/

# ----- Experiments — campaign outputs -----
experiments/campaigns/*/results/
experiments/campaigns/*/analyses/
experiments/campaigns/*/work/
experiments/campaigns/*/.nextflow*
experiments/campaigns/*/*.out
experiments/campaigns/*/*.err

# ----- Experiments — AF3 monomer prediction outputs -----
# AF3 jobs run on HPC and the prediction trees are large (~MBs per run).
# Inputs (slurm script, JSON, fasta) ARE tracked; outputs are not.
experiments/inputs/structures/AF3/*/alphafold3_*_output/

# ----- Large data that shouldn't be tracked -----
# Be cautious — your tests/ directory has small PDB files
# that ARE tracked. Add specific patterns here if needed.
# *.pdb              # don't enable globally — your test data uses .pdb
# *.cif

# ----- OS / misc -----
Thumbs.db
desktop.ini

# Test data
tests/full_test_run/example_output_files/*
!tests/full_test_run/example_output_files/README.md


# Word lockfiles (temporary files Word creates while a doc is open)
~$*

# Slurm log files at any test path
tests/*/*.out
tests/*/*.err

# Pulled-from-HPC helper artefacts for path-coverage analysis
tests/full_test_run/reference_data_helpers/

# Lab protocols — large binary reference documents (209 MB); not version-controlled
notes/Lab Protocols/

# Nextflow runtime artefacts (work dirs, logs, metadata, report outputs)
work/
.nextflow/
.nextflow.log*
receptor_resurfacing_results/
